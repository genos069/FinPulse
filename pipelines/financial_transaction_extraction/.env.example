# Worker configuration. Set these as real environment variables (or in your host's secret manager).
# Never commit a real .env file.
MONGODB_URI=mongodb+srv://<worker-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=finpulse
GRIDFS_BUCKET=fs                 # must equal the Spring Boot GRIDFS_BUCKET

# Label only: a random suffix is always appended so every process has a unique lease token.
WORKER_ID=finpulse-worker
POLL_INTERVAL=5                  # seconds between polls when idle
JOB_LEASE_SECONDS=300            # a job is recoverable by another worker after this long without a heartbeat
MAX_JOB_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=30
JOB_BACKOFF_MAX_SECONDS=3600
TEMP_DIRECTORY=                  # empty = system temp dir; downloaded files are deleted after each job
MAX_FILE_BYTES=26214400
ENSURE_INDEXES=true
HEALTH_FILE=                     # optional: touched every loop iteration (used by container health checks)
LOG_LEVEL=INFO

# PRIVACY: when true, merchant/description text of uncategorised transactions is sent to an external LLM
# provider (needs ANTHROPIC_API_KEY). Leave false unless users have been informed and have consented.
ENABLE_LLM_CATEGORIZER=false
