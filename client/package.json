{
  "name": "finpulse-react-native",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "format": "prettier --write App.tsx index.ts src tests docs README.md"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
