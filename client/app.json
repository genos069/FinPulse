{
  "expo": {
    "name": "FinPulse",
    "slug": "finpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "finpulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.finpulse"
    },
    "android": {
      "package": "com.example.finpulse"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Record an expense for transcription.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select a receipt to extract an expense.",
          "cameraPermission": "Photograph a receipt to extract an expense.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock FinPulse with Face ID."
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ]
  }
}
